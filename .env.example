# すべて未設定なら「デモモード」（メモリ上のサンプルデータ・デモ用ログイン）で動きます。

# Supabase（3つそろうと本番モード）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# QRコードに入れる公開URL（例：https://taikoban.example.com）。未設定ならアクセス中のホストを使う
NEXT_PUBLIC_SITE_URL=

# ご意見のメール通知（Resend）。未設定ならログに出すだけ
RESEND_API_KEY=
RESEND_FROM="太鼓判くん <notify@your-domain.jp>"

# デモモードのログイン Cookie の署名キー
SESSION_SECRET=
